# Copy to .env (git-ignored). Quarkus loads it from the working directory.
PORT=8080

# Only required in the prod profile
JWT_ISSUER=http://localhost:8080
DB_URL=jdbc:postgresql://localhost:5432/auth
DB_USER=auth
DB_PASSWORD=change-me
JWT_PUBLIC_KEY_LOCATION=/path/to/public.pem
JWT_PRIVATE_KEY_LOCATION=/path/to/private.pem
